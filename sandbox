#!/usr/bin/env bash
set -euo pipefail

#
# Run commands inside the Sail container from the addon directory.
#
# Usage:
#   ./sandbox <command>
#
# Examples:
#   ./sandbox npm install
#   ./sandbox npm run dev
#   ./sandbox composer install
#   ./sandbox php vendor/bin/pest
#   ./sandbox php vendor/bin/pint
#   ./sandbox artisan <command>     (shorthand for php artisan in the sandbox app)
#

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADDON_NAME="$(basename "$SCRIPT_DIR")"
SANDBOX_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SAIL="${SANDBOX_ROOT}/vendor/bin/sail"
ADDON_CONTAINER_PATH="addons/${ADDON_NAME}"

if [[ $# -eq 0 ]]; then
    echo "Usage: ./sandbox <command>"
    echo ""
    echo "Examples:"
    echo "  ./sandbox npm install"
    echo "  ./sandbox npm run dev"
    echo "  ./sandbox composer install"
    echo "  ./sandbox php vendor/bin/pest"
    echo "  ./sandbox php vendor/bin/pint"
    echo "  ./sandbox artisan tinker"
    exit 1
fi

# "artisan" is a shorthand for running artisan in the sandbox app (not the addon)
if [[ "$1" == "artisan" ]]; then
    shift
    cd "$SANDBOX_ROOT"
    exec "$SAIL" artisan "$@"
fi

# Everything else runs in the addon directory inside the container
cd "$SANDBOX_ROOT"
exec "$SAIL" shell -c "cd ${ADDON_CONTAINER_PATH} && $*"
