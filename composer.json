{
    "name": "el-schneider/statamic-content-mcp",
    "description": "A Statamic addon",
    "license": "MIT",
    "homepage": "https://github.com/el-schneider/statamic-content-mcp",
    "authors": [
        {
            "name": "el-schneider",
            "homepage": "https://github.com/el-schneider"
        }
    ],
    "require": {
        "statamic/cms": "^6.0",
        "laravel/mcp": "^0.6"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "laravel/pint": "^1.21",
        "pestphp/pest": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "ElSchneider\\ContentMcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "statamic-content-mcp",
            "description": "A Statamic addon"
        },
        "laravel": {
            "providers": [
                "ElSchneider\\ContentMcp\\ContentMcpServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "vendor/bin/pint",
        "test": "vendor/bin/pest --no-coverage",
        "ci": [
            "@pint --test",
            "@test"
        ]
    }
}
