{
    "name": "el-schneider/statamic-content-mcp",
    "description": "Lets editors work on a Statamic site from an AI assistant over MCP, signed in with their own Control Panel account and permissions.",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "mcp",
        "model-context-protocol",
        "ai-assistant",
        "oauth",
        "laravel"
    ],
    "homepage": "https://github.com/el-schneider/statamic-content-mcp",
    "support": {
        "issues": "https://github.com/el-schneider/statamic-content-mcp/issues",
        "source": "https://github.com/el-schneider/statamic-content-mcp"
    },
    "authors": [
        {
            "name": "Jonas List",
            "homepage": "https://github.com/el-schneider"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/mcp": "^1.2",
        "laravel/passport": "^13.0",
        "statamic/cms": "^6.31"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.3 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "ElSchneider\\ContentMcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Content MCP",
            "description": "Let editors read and draft content from an AI assistant, with their own permissions."
        },
        "laravel": {
            "providers": [
                "ElSchneider\\ContentMcp\\ContentMcpServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "types:check": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test": "vendor/bin/pest",
        "check": [
            "@lint:check",
            "@types:check",
            "@test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@check"
        ]
    }
}
