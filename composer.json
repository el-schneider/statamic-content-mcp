{
    "name": "el-schneider/statamic-content-mcp",
    "description": "Connect Claude to a Statamic site so editors can read and draft content with their own Control Panel permissions.",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "mcp",
        "model-context-protocol",
        "claude",
        "oauth",
        "laravel"
    ],
    "homepage": "https://github.com/el-schneider/statamic-content-mcp",
    "support": {
        "issues": "https://github.com/el-schneider/statamic-content-mcp/issues",
        "source": "https://github.com/el-schneider/statamic-content-mcp"
    },
    "authors": [
        {
            "name": "Jonas List",
            "homepage": "https://github.com/el-schneider"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/mcp": "^1.2",
        "laravel/passport": "^13.0",
        "statamic/cms": "^6.31"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ElSchneider\\ContentMcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Content MCP",
            "description": "Connect Claude to your site so editors can read and draft content with their own permissions."
        },
        "laravel": {
            "providers": [
                "ElSchneider\\ContentMcp\\ContentMcpServiceProvider"
            ]
        }
    },
    "scripts": {
        "check": [
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
            "vendor/bin/pest"
        ],
        "fix": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    }
}
