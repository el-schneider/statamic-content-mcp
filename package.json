{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "check": "npm run format:check && npm run lint && npm run pint:check",
    "fix": "npm run format:fix && npm run lint:fix && npm run pint:fix",
    "format:check": "prettier --check --ignore-unknown $(git ls-files)",
    "format:fix": "prettier --write --ignore-unknown $(git ls-files)",
    "pint:check": "./vendor/bin/pint --test",
    "pint:fix": "./vendor/bin/pint",
    "test": "./vendor/bin/pest",
    "lint": "eslint resources/js/",
    "lint:fix": "eslint resources/js/ --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^2.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "vite": "^8.0.3"
  }
}
